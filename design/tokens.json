{
  "$description": "Design tokens exported from src/styles/tokens.css by scripts/design-tokens.mjs (W3C design-tokens format). Do not edit by hand.",
  "defaultPalette": "slate-indigo",
  "palette": {
    "slate-indigo": {
      "$description": "Slate & Muted Indigo. Deep charcoal surfaces, indigo identity accent, cyan actions. Site default.",
      "color": {
        "canvas": {
          "$type": "color",
          "$value": "#0B0E14",
          "$description": "page background"
        },
        "surface": {
          "$type": "color",
          "$value": "#181B24",
          "$description": "cards and panels"
        },
        "surface-raised": {
          "$type": "color",
          "$value": "#202532",
          "$description": "inputs and hover surfaces"
        },
        "border": {
          "$type": "color",
          "$value": "#2B3040",
          "$description": "decorative card and divider lines"
        },
        "border-strong": {
          "$type": "color",
          "$value": "#64748B",
          "$description": "outlines that identify a control (form inputs), and hover borders"
        },
        "text-primary": {
          "$type": "color",
          "$value": "#E2E8F0",
          "$description": "headings and body copy"
        },
        "text-secondary": {
          "$type": "color",
          "$value": "#94A3B8",
          "$description": "descriptions and supporting copy"
        },
        "text-tertiary": {
          "$type": "color",
          "$value": "#8190A8",
          "$description": "labels, placeholders, footer"
        },
        "accent-primary": {
          "$type": "color",
          "$value": "#6366F1",
          "$description": "identity accent: fills, icons, borders, large type"
        },
        "accent-primary-text": {
          "$type": "color",
          "$value": "#818CF8",
          "$description": "identity accent for small text on dark surfaces"
        },
        "accent-secondary": {
          "$type": "color",
          "$value": "#38BDF8",
          "$description": "action accent: buttons, focus ring, progress"
        },
        "on-accent": {
          "$type": "color",
          "$value": "#0B0E14",
          "$description": "label colour on action and status fills"
        },
        "success": {
          "$type": "color",
          "$value": "#34D399",
          "$description": "positive status"
        },
        "alert": {
          "$type": "color",
          "$value": "#F87171",
          "$description": "error status"
        }
      }
    },
