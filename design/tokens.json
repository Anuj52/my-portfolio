  "space": {
    "xs": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "8px: icon gaps, tight stacks"
    },
    "sm": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "16px: heading to paragraph"
    },
    "md": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "24px: between major blocks, card padding"
    },
    "lg": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "32px: card padding on desktop"
    },
    "xl": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "48px: section header to content"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "64px: large gaps"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "96px",
      "$description": "96px: section padding"
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "8px: cards, buttons, inputs, menus"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Geist",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "Instrument Serif",
        "ui-serif",
        "Georgia",
        "Times New Roman",
        "serif"
      ]
    }
  },
  "text": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(2.75rem, 1.6rem + 4.8vw, 4.5rem)",
        "lineHeight": "1",
        "letterSpacing": "-0.04em",
        "fontWeight": "700"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.5rem, 1.25rem + 1vw, 2rem)",
        "lineHeight": "1.2",
        "letterSpacing": "-0.02em",
        "fontWeight": "700"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)",
        "lineHeight": "1.3",
        "letterSpacing": "-0.01em",
        "fontWeight": "600"
      }
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontSize": "clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem)",
        "lineHeight": "1.35",
        "letterSpacing": "-0.01em"
      }
    }
  },
  "tailwindAliases": {
    "raised": "surface-raised",
    "line": "border",
    "line-strong": "border-strong",
    "fg": "text-primary",
    "muted": "text-secondary",
    "subtle": "text-tertiary",
    "accent": "accent-primary",
    "accent-text": "accent-primary-text",
    "action": "accent-secondary"
  }
}
